    <string name="notif_stop">Stop</string>

    <!-- Setup screen (for the installer; English only on purpose) -->
    <string name="setup_title" translatable="false">Setup needed (one-time)</string>
    <string name="setup_intro" translatable="false">This screen is for the person installing the app, not the daily user. Run these two commands once with the phone connected to a computer (USB debugging on). After they succeed, tap "Check again" and this screen will not appear again.</string>
    <string name="setup_cmd1" translatable="false">adb shell pm grant com.gurnoor.locationchanger android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="setup_cmd2" translatable="false">adb shell appops set com.gurnoor.locationchanger android:mock_location allow</string>
    <string name="setup_check_again" translatable="false">Check again</string>
    <string name="setup_copy" translatable="false">Copy</string>
    <string name="setup_copied" translatable="false">Copied</string>
    <string name="setup_status_write" translatable="false">Secure-settings permission</string>
    <string name="setup_status_mock" translatable="false">Mock location allowed</string>
    <string name="setup_granted" translatable="false">Done</string>
    <string name="setup_missing" translatable="false">Not yet</string>
    <string name="setup_samsung" translatable="false">On Samsung (One UI): also add this app to Settings → Battery → Background usage limits → Never sleeping apps, so the system does not stop it.</string>
