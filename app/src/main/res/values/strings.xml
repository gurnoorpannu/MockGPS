    <!-- Help -->
    <string name="help">Help</string>
    <string name="help_title">How to use</string>
    <string name="help_step1">1. Find a place: type its name and tap Search, or tap the map.</string>
    <string name="help_step2">2. A pin shows the place you chose.</string>
    <string name="help_step3">3. Tap the green button "Change location here".</string>
    <string name="help_step4">4. Your phone now shows that place to other apps.</string>
    <string name="help_step5">5. To go back, tap the red button "Stop – go back to real location".</string>
